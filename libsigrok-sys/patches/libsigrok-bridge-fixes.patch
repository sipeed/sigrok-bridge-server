# sigrok-bridge integration: advertise a fixed list of capture depths via
# SR_CONF_LIMIT_SAMPLES | SR_CONF_LIST. Applied at build time to the copied
# libsigrok source (deps.rs build_libsigrok); guarded by the sampledepths_slogic
# marker so a re-run or an upstream that already carries it is a no-op.
diff --git a/src/hardware/sipeed-slogic-analyzer/api.c b/src/hardware/sipeed-slogic-analyzer/api.c
index 87f16df8..ffb425e7 100644
--- a/src/hardware/sipeed-slogic-analyzer/api.c
+++ b/src/hardware/sipeed-slogic-analyzer/api.c
@@ -43,7 +43,7 @@ static const uint32_t drvopts[] = {
 
 static const uint32_t devopts[] = {
 	SR_CONF_CONTINUOUS,
-	SR_CONF_LIMIT_SAMPLES | SR_CONF_GET | SR_CONF_SET,
+	SR_CONF_LIMIT_SAMPLES | SR_CONF_GET | SR_CONF_SET | SR_CONF_LIST,
 	SR_CONF_PATTERN_MODE | SR_CONF_GET | SR_CONF_SET | SR_CONF_LIST,
 	SR_CONF_SAMPLERATE | SR_CONF_GET | SR_CONF_SET | SR_CONF_LIST,
 	SR_CONF_TRIGGER_MATCH | SR_CONF_LIST,
@@ -51,6 +51,18 @@ static const uint32_t devopts[] = {
 	SR_CONF_NUM_LOGIC_CHANNELS | SR_CONF_GET | SR_CONF_SET | SR_CONF_LIST
 };
 
+/* Selectable capture depths advertised to the host through
+ * SR_CONF_LIMIT_SAMPLES | SR_CONF_LIST (consumed by sigrok-bridge). */
+static const uint64_t sampledepths_slogic[] = {
+	UINT64_C(1000), UINT64_C(2000), UINT64_C(5000),
+	UINT64_C(10000), UINT64_C(20000), UINT64_C(50000),
+	UINT64_C(100000), UINT64_C(200000), UINT64_C(500000),
+	UINT64_C(1000000), UINT64_C(2000000), UINT64_C(5000000),
+	UINT64_C(10000000), UINT64_C(20000000), UINT64_C(50000000),
+	UINT64_C(100000000), UINT64_C(200000000), UINT64_C(500000000),
+	UINT64_C(1000000000),
+};
+
 /* Model tables (samplerates, channel modes, ceilings, pattern names) now
  * live in the shared core (slogic/) and are read through slogic_model and
  * the slogic_* accessors. */
@@ -495,6 +507,9 @@ static int config_list(uint32_t key, GVariant **data,
 	case SR_CONF_VOLTAGE_THRESHOLD:
 		*data = std_gvar_min_max_step_thresholds(0, 6, 0.1);
 		break;
+	case SR_CONF_LIMIT_SAMPLES:
+		*data = std_gvar_array_u64(ARRAY_AND_SIZE(sampledepths_slogic));
+		break;
 	default:
 		ret = SR_ERR_NA;
 	}
